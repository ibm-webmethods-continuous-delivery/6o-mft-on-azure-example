    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-aks-000000000006" source="id-tech-aks-00000000000006" target="id-app-sf-aks-000000000006"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-appgw-00000000007" source="id-tech-appgw-0000000000007" target="id-app-sf-appgw-00000000007"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-postgres-0000008" source="id-tech-postgres-000000008" target="id-app-sf-postgres-0000008"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-keyvault-000000009" source="id-tech-keyvault-000000000001" target="id-app-sf-keyvault-000000009"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-lb-00000000000010" source="id-tech-lb-000000000000009" target="id-app-sf-lb-00000000000010"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-sftpvms-000000011" source="id-tech-vm-000000000000010" target="id-app-sf-sftpvms-000000011"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-rel-sf-storage-00000012" source="id-tech-storage-000000000002" target="id-app-sf-storage-00000012"/>
